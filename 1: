for j in jhc:
    print(f"  {j}")

# 6. SSD espaço
print(f"\n[6] SSD ESPAÇO:")
r = subprocess.run(["df", "-h", "/Volumes/SSD EXT MACBOOK"], capture_output=True, text=True)
lines = r.stdout.strip().split("\n")
if len(lines) > 1:
